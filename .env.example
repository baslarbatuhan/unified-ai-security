# Root .env — used by local `uvicorn` / pytest (not Docker compose).
# Docker stack reads infra/.env instead (see infra/.env.example).
#
#   cp .env.example .env

# Hugging Face — optional, faster BGE-M3 download
HF_TOKEN=
HF_HOME=.cache/huggingface

# cpu (default) or cuda — CPU keeps GPU free for Ollama judge
EMBEDDING_DEVICE=cpu

# Local Ollama (default). In compose, gateway uses http://ollama:11434
OLLAMA_HOST=http://localhost:11434

# Preload prompt_guard + rag_guard pipelines at startup (recommended)
# UAIS_WARM_UP_PIPELINES=1

# Fail startup when security_selfcheck fails (default: warn and continue)
# STRICT_SECURITY_STARTUP=1

# Target secrets for local external_eval (or use Dashboard → Targets vault)
# MY_OPENWEBUI_KEY=sk-...
